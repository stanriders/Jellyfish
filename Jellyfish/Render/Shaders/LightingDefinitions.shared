#define MAX_LIGHTS 256
#define MAX_SHADOWS_PER_LIGHTS 8
#define CSM_CASCADES 4
//#define CSM_DEBUG

const float PI = 3.14159265359;

struct Light {
    vec3 position;    float _pad0;
    vec3 direction;    float _pad1;
    mat4 lightSpaceMatrix[MAX_SHADOWS_PER_LIGHTS];

    int type;
    float constant;
    float linear;
    float quadratic;

    float cone;
    float outcone;
    float brightness;
    bool hasShadows;

    vec3 diffuse;    float _pad2;

    float near;
    float far;
    bool usePcss;    float _pad3;
    
    sampler2D shadow[MAX_SHADOWS_PER_LIGHTS];
};

struct Sun {
    vec3 direction;  float _pad0;

    mat4 lightSpaceMatrix[CSM_CASCADES];

    vec3 diffuse;    float _pad1;

    float brightness;
    bool   hasShadows;
    bool   usePcss;   int _pad2;

    int cascadeFar[CSM_CASCADES];
    int cascadeNear[CSM_CASCADES];
    sampler2D shadow[CSM_CASCADES];
};

layout(std430, binding = 0) buffer LightSources {
    Light lightSources[MAX_LIGHTS];
    Sun   sun;
    int   lightSourcesCount;
    bool  sunEnabled;
};

